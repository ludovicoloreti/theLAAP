#!/bin/bash
# laguna-esclusivo.sh — regime "un modello grande, e basta".
#
# PERCHÉ ESISTE
# Laguna-S-2.1-oQ6e occupa ~89,5 GiB. Su questa macchina da 128 GiB ci sta
# comodamente, ma NON insieme a mtplx (che arriva a 79 GiB di picco): il
# 27/07/2026 i due insieme hanno causato un kernel panic.
#
# Il rifiuto che si vedeva col profilo normale NON era mancanza di RAM — la
# macchina aveva 16,4 GB liberi e swap a zero. Era il margine che oMLX si
# impone: cap di prefill = (tetto - riserva hot cache) x margine del tier.
# Due manopole lo stringevano senza motivo in un uso mono-modello:
#
#   1. hot_cache_max_size 8GB viene SOTTRATTO dal tetto di abort: 8 GB di
#      cache dei prompt costano 8 GB di margine di prefill.
#   2. il tier "balanced" usa il 90% del tetto, "custom" il 95%
#      (_PREFILL_ABORT_MARGIN in process_memory_enforcer.py).
#
# "custom" è cieco agli altri processi — ed è esattamente perché causò il
# panic. Ma qui non c'è nient'altro da vedere: è questo che rende il regime
# esclusivo la condizione in cui quel tier torna sicuro.
#
# USO
#   ./laguna-esclusivo.sh on     entra nel regime (ferma mtplx + margini larghi)
#   ./laguna-esclusivo.sh off    ripristina tutto
#   ./laguna-esclusivo.sh stato  mostra dove sei
#
#   margini-larghi / margini-prudenti
#     Solo la parte di memoria, senza toccare gli altri programmi. Sono i due
#     comandi che invoca theLAAP: il pannello sa già fermare e riaccendere i
#     runtime, e li ferma PRIMA di chiamare margini-larghi — l'ordine conta,
#     perché allargare i margini con un altro modello ancora residente è
#     esattamente la configurazione che ha fatto panicare la macchina.
set -uo pipefail

OMLX_CFG="$HOME/.omlx/settings.json"
AGENT_OMLX="$HOME/Library/LaunchAgents/com.lloreti.omlx.plist"
AGENT_MTPLX="$HOME/Library/LaunchAgents/com.lloreti.mtplx.plist"
SEGNO="$HOME/.omlx/.laguna-esclusivo"
UID_=$(id -u)

# Profilo esclusivo. 112 = il cap Metal: oltre non si va comunque, e tenerlo
# lì fa scattare il rifiuto pulito (105,4 GiB) PRIMA dell'abort distruttivo
# (106,4 GiB). L'ordine conta: invertito, una richiesta lunga ammazzerebbe
# tutte le altre invece di essere rifiutata da sola.
GUARD_ESCL=112
HOT_ESCL='"1GB"'
# Profilo normale, quello che convive con mtplx.
HOT_NORM='"8GB"'

msg(){ printf '  %s\n' "$*"; }

libera_gb(){ python3 - <<'PY'
import subprocess
o=subprocess.run(['vm_stat'],capture_output=True,text=True).stdout
d={l.split(':')[0].strip():int(l.split(':')[1].strip().rstrip('.'))*16384
   for l in o.splitlines() if ':' in l and l.split(':')[1].strip().rstrip('.').isdigit()}
print(f"{(d['Pages free']+d['Pages inactive'])/1e9:.1f}")
PY
}

attende(){ # attende <url> <secondi>
  local i; for i in $(seq 1 "$2"); do
    curl -s --max-time 4 "$1" >/dev/null 2>&1 && return 0; sleep 2
  done; return 1
}

imposta_hot(){ # imposta_hot <valore-json>
  python3 - "$OMLX_CFG" "$1" <<'PY'
import json,sys
p,v=sys.argv[1],json.loads(sys.argv[2])
d=json.load(open(p)); d.setdefault("cache",{})["hot_cache_max_size"]=v
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False)
PY
}

imposta_guard(){ # imposta_guard esclusivo|normale
  python3 - "$AGENT_OMLX" "$1" "$GUARD_ESCL" <<'PY'
import plistlib,sys
p,modo,gb=sys.argv[1],sys.argv[2],sys.argv[3]
d=plistlib.load(open(p,'rb')); a=d["ProgramArguments"]
# togli qualunque impostazione precedente del guard
out=[];i=0
while i<len(a):
    if a[i] in ("--memory-guard","--memory-guard-gb"): i+=2; continue
    out.append(a[i]); i+=1
out += (["--memory-guard-gb",gb] if modo=="esclusivo" else ["--memory-guard","balanced"])
d["ProgramArguments"]=out
plistlib.dump(d,open(p,'wb'))
print("  argomenti:"," ".join(out[-2:]))
PY
}

riavvia_omlx(){
  # bootout+bootstrap, non kickstart: launchd NON rilegge il plist con kickstart.
  launchctl bootout "gui/$UID_/com.lloreti.omlx" 2>/dev/null; sleep 5
  launchctl bootstrap "gui/$UID_" "$AGENT_OMLX" 2>/dev/null
  attende http://127.0.0.1:8000/health 40
}

# Solo la parte di memoria. theLAAP chiama questi due: il pannello ha già
# fermato gli altri programmi prima di arrivare qui.
margini_larghi(){
  msg "hot cache 8GB → 1GB (restituisce ~7 GiB di tetto di prefill)"
  imposta_hot "$HOT_ESCL"
  msg "memory guard → custom $GUARD_ESCL GiB (margine 0,95 invece di 0,90)"
  imposta_guard esclusivo
  msg "riavvio oMLX"
  if riavvia_omlx; then msg "oMLX pronto"; else msg "ATTENZIONE: oMLX non risponde"; fi
  touch "$SEGNO"
  msg "memoria libera: $(libera_gb) GB"
}

margini_prudenti(){
  msg "hot cache → 8GB"; imposta_hot "$HOT_NORM"
  msg "memory guard → balanced (torna a vedere gli altri processi)"; imposta_guard normale
  msg "riavvio oMLX"
  if riavvia_omlx; then msg "oMLX pronto"; else msg "ATTENZIONE: oMLX non risponde"; fi
  rm -f "$SEGNO"
}

case "${1:-stato}" in
margini-larghi)   margini_larghi; exit 0 ;;
margini-prudenti) margini_prudenti; exit 0 ;;
on)
  [ -f "$SEGNO" ] && { msg "sei già in regime esclusivo"; exit 0; }
  msg "1/4 fermo mtplx (qwen resterà irraggiungibile fino a «off»)"
  launchctl bootout "gui/$UID_/com.lloreti.mtplx" 2>/dev/null; sleep 6
  msg "    memoria libera ora: $(libera_gb) GB"
  msg "2/4 hot cache 8GB → 1GB (restituisce ~7 GiB di tetto di prefill)"
  imposta_hot "$HOT_ESCL"
  msg "3/4 memory guard → custom $GUARD_ESCL GiB (margine 0,95 invece di 0,90)"
  imposta_guard esclusivo
  msg "4/4 riavvio oMLX"
  if riavvia_omlx; then msg "    oMLX pronto"; else msg "    ATTENZIONE: oMLX non risponde"; fi
  touch "$SEGNO"
  msg ""
  msg "Regime esclusivo attivo. Carica Laguna quando vuoi."
  msg "Per uscire e riavere qwen:  ./laguna-esclusivo.sh off"
  ;;
off)
  msg "1/4 hot cache → 8GB"; imposta_hot "$HOT_NORM"
  msg "2/4 memory guard → balanced (torna a vedere gli altri processi)"; imposta_guard normale
  msg "3/4 riavvio oMLX"; riavvia_omlx >/dev/null && msg "    oMLX pronto" || msg "    ATTENZIONE: oMLX non risponde"
  msg "4/4 riaccendo mtplx"
  launchctl bootstrap "gui/$UID_" "$AGENT_MTPLX" 2>/dev/null
  if attende http://127.0.0.1:8080/v1/models 60; then msg "    qwen pronto"; else msg "    ATTENZIONE: mtplx non risponde"; fi
  rm -f "$SEGNO"
  msg ""; msg "Stato normale ripristinato."
  ;;
stato)
  [ -f "$SEGNO" ] && msg "regime: ESCLUSIVO" || msg "regime: normale"
  msg "hot cache:  $(python3 -c "import json;print(json.load(open('$OMLX_CFG'))['cache']['hot_cache_max_size'])" 2>/dev/null)"
  msg "guard:      $(launchctl print "gui/$UID_/com.lloreti.omlx" 2>/dev/null | grep -A1 -- '--memory-guard' | tail -1 | tr -d ' \t')"
  msg "mtplx:      $(curl -s --max-time 3 http://127.0.0.1:8080/v1/models >/dev/null 2>&1 && echo acceso || echo spento)"
  msg "oMLX:       $(curl -s --max-time 3 http://127.0.0.1:8000/health >/dev/null 2>&1 && echo acceso || echo spento)"
  msg "libera:     $(libera_gb) GB"
  ;;
*)
  echo "uso: $0 on|off|stato"; exit 1;;
esac
